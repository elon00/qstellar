STELLAR_RAVEN_MCP_URL=https://raven.stellar.org/mcp
STELLAR_RAVEN_TIMEOUT_MS=10000

# ------------------------------------------------------------------------------
# 3. x402 BAZAAR PROTOCOL GATEWAY
# ------------------------------------------------------------------------------
X402_GATEWAY_PORT=4020
X402_SETTLEMENT_ASSET=USDC
X402_SETTLEMENT_ISSUER=GBBD47IF6LWK7P7MDEVSCWR7DPUWV3NY3DTQEVFL4NAT4AQH3ZLLFLA5
X402_FACILITATOR_ACCOUNT=GDFACILITATORTESTNETACCOUNT7QSTELLAR2026SAFEGATEWAY9999
X402_REQUIRE_CONFIRMATION=true

# ------------------------------------------------------------------------------
# 4. MULTI-MODEL AI PROVIDERS (Server-side only)
# ------------------------------------------------------------------------------
# Set the keys for any providers you want the agent router to invoke
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
DEEPSEEK_API_KEY=
